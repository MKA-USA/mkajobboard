# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173

# Google Sheets API
GOOGLE_SHEETS_PRIVATE_KEY="your-private-key"
GOOGLE_SHEETS_CLIENT_EMAIL="your-client-email"
